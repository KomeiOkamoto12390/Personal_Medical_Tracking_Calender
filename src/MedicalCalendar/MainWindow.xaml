<Window x:Class="MedicalCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MedicalCalendar"
        Title="Medical Calendar" Width="1240" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:CategorySection}">
            <local:SectionCard/>
        </DataTemplate>
        <DataTemplate x:Key="CompactSectionTemplate" DataType="{x:Type local:CategorySection}">
            <local:SectionCard Compact="True"/>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource TodayBrush}">
                        <TextBlock x:Name="LogoDay" Foreground="White" FontWeight="Bold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Medical Calendar" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" FontSize="11" Margin="8,4,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="11" Margin="8,0,0,0"
                           Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"/>

                <!-- Shown when a newer version has been downloaded in the background -->
                <Border x:Name="UpdateBanner" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,0,0,14"
                        Background="#E8F0FE" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Update ready" FontSize="13" FontWeight="SemiBold" Foreground="#1A4FAF"/>
                        <TextBlock x:Name="UpdateText" FontSize="12" Foreground="#1A4FAF" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <Button Style="{StaticResource AccentButton}" Height="30" HorizontalAlignment="Left"
                                Content="Restart to update" AutomationProperties.Name="Restart to update"
                                Click="ApplyUpdate_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavDay" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="&#xE8BF;" Content="Today" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCalendar" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="&#xE787;" Content="Calendar" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavExport" Style="{StaticResource NavItem}" GroupName="nav"
                                 Tag="&#xE896;" Content="Export" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Daily log page ================= -->
        <ScrollViewer x:Name="DayPage" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="DayContent" MaxWidth="860" Margin="36,26,36,40">
                <DockPanel Margin="0,0,0,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous day (←)" Click="PrevDay_Click"/>
                        <Button Style="{StaticResource PillButton}" Content="Today" Margin="6,0" ToolTip="Go to today (T)" Click="Today_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next day (→)" Click="NextDay_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="DayKicker" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TodayBrush}"/>
                        <TextBlock x:Name="DayTitle" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <ItemsControl x:Name="SectionsList" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10" Fill="#8E8E93" VerticalAlignment="Center"/>
                            <TextBlock Text="Notes" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="NotesBox" Style="{StaticResource BareTextBox}" MinHeight="90"
                                     TextChanged="NotesBox_TextChanged"/>
                            <TextBlock x:Name="NotesHint" IsHitTestVisible="False" FontSize="14" Margin="2,0,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="How are you feeling? Anything else worth remembering…"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Calendar page ================= -->
        <Grid x:Name="CalendarPage" Grid.Column="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="28,18,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="Previous month (PgUp)" Click="PrevMonth_Click"/>
                        <Button Style="{StaticResource PillButton}" Content="Today" Margin="6,0" ToolTip="Go to today (T)" Click="TodayMonth_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="Next month (PgDn)" Click="NextMonth_Click"/>
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="30" VerticalAlignment="Center">
                        <Run x:Name="MonthRun" FontWeight="Bold"/>
                        <Run x:Name="YearRun" Foreground="{StaticResource SubtleBrush}"/>
                    </TextBlock>
                </DockPanel>

                <ItemsControl Grid.Row="1" x:Name="WeekdayHeader" Margin="0,18,0,8" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="10,0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,1,0,0" ClipToBounds="True">
                    <ItemsControl x:Name="DaysGrid" Focusable="False" MouseWheel="DaysGrid_MouseWheel">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform/>
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DayCell}">
                                <Button x:Name="Cell" Style="{StaticResource DayButton}" Tag="{Binding}" Click="Day_Click"
                                        AutomationProperties.Name="{Binding Date, StringFormat=yyyy-MM-dd}">
                                    <Grid Margin="6,6,6,4" ClipToBounds="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="NumBg" Width="26" Height="26" CornerRadius="13"
                                                HorizontalAlignment="Left" Background="Transparent">
                                            <TextBlock x:Name="Num" Text="{Binding DayNumber}" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Preview}" Margin="0,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:Chip}">
                                                    <Border Background="{Binding Bg}" CornerRadius="4" Margin="0,0,0,3"
                                                            BorderBrush="{Binding Bar}" BorderThickness="3,0,0,0" Padding="6,2,4,2">
                                                        <TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{Binding Ink}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{StaticResource WeekendBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        <Setter TargetName="Cell" Property="Opacity" Value="0.75"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Cell" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                        <Setter TargetName="NumBg" Property="Background" Value="{StaticResource SelectedNumBrush}"/>
                                        <Setter TargetName="Num" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="NumBg" Property="Background" Value="{StaticResource TodayBrush}"/>
                                        <Setter TargetName="Num" Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Day panel (slides in from the right) -->
            <Border x:Name="DayPanel" Grid.Column="1" Width="440" Visibility="Collapsed"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="22,20,14,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                ToolTip="Close (Esc)" AutomationProperties.Name="Close panel" Click="ClosePanel_Click"
                                VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="PanelKicker" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TodayBrush}"/>
                            <TextBlock x:Name="PanelTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="PanelContent" Margin="16,0,16,20">
                            <ItemsControl x:Name="PanelSections" ItemTemplate="{StaticResource CompactSectionTemplate}" Focusable="False"/>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="10" Height="10" Fill="#8E8E93" VerticalAlignment="Center"/>
                                        <TextBlock Text="Notes" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Grid>
                                        <TextBox x:Name="PanelNotesBox" Style="{StaticResource BareTextBox}" MinHeight="70"
                                                 TextChanged="NotesBox_TextChanged"/>
                                        <TextBlock x:Name="PanelNotesHint" IsHitTestVisible="False" FontSize="14" Margin="2,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                   Text="Anything else worth remembering…"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Export page ================= -->
        <local:ExportView x:Name="ExportPage" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Window>
