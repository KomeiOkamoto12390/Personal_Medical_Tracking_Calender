<UserControl x:Class="MedicalCalendar.SuggestBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MedicalCalendar"
             x:Name="Self">
    <Grid>
        <TextBox x:Name="Input" Padding="10,5,34,6" VerticalContentAlignment="Center"
                 TextChanged="Input_TextChanged"
                 PreviewKeyDown="Input_PreviewKeyDown"
                 LostKeyboardFocus="Input_LostKeyboardFocus"/>

        <TextBlock x:Name="Hint" IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis"
                   Text="{Binding Placeholder, ElementName=Self}"/>

        <Button x:Name="Arrow" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                Width="28" Height="28" Margin="0,0,3,0" FontSize="10" Content="&#xE70D;"
                ToolTip="Show all" Click="Arrow_Click"/>

        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               HorizontalOffset="-10" VerticalOffset="-6" Closed="Pop_Closed">
            <Border Margin="10" Background="{StaticResource BgBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4"
                    MinWidth="{Binding ActualWidth, ElementName=Input}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.14"/>
                </Border.Effect>
                <Grid>
                    <ListBox x:Name="List" MaxHeight="340" BorderThickness="0" Background="Transparent"
                             Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="10,8,0,3" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CatalogItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="RemoveBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                                            Width="24" Height="24" FontSize="9" Content="&#xE711;"
                                            ToolTip="Remove from My items" Visibility="Collapsed"
                                            AutomationProperties.Name="Remove custom item"
                                            Command="{Binding RemoveItemCommand, ElementName=Self}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Group}" Value="My items">
                                        <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoMatch" Margin="10,8" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                               Visibility="Collapsed" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
