<UserControl x:Class="MedicalCalendar.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="PageContent" MaxWidth="860" Margin="36,26,36,40">

            <TextBlock Text="FOR YOUR DOCTOR" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TodayBrush}"/>
            <TextBlock Text="Export" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Margin="0,2,0,0"/>
            <TextBlock Text="Create a PDF report of your log to bring to an appointment, or a CSV for a spreadsheet."
                       FontSize="13" Foreground="{StaticResource SubtleBrush}" Margin="0,4,0,22" TextWrapping="Wrap"/>

            <!-- Period -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Time period" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="7d"  Content="Last 7 days"   Checked="Preset_Checked"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="30d" Content="Last 30 days"  Checked="Preset_Checked" x:Name="DefaultPreset"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="3m"  Content="Last 3 months" Checked="Preset_Checked"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="6m"  Content="Last 6 months" Checked="Preset_Checked"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="year" Content="This year"    Checked="Preset_Checked"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="all" Content="All time"      Checked="Preset_Checked"/>
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="period" Tag="custom" Content="Custom"     Checked="Preset_Checked" x:Name="CustomPreset"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="From" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="2,0,0,4"/>
                            <DatePicker x:Name="FromPicker" Width="180" SelectedDateChanged="Range_Changed"/>
                        </StackPanel>
                        <TextBlock Text="–" FontSize="16" VerticalAlignment="Bottom" Margin="12,0,12,6" Foreground="{StaticResource SubtleBrush}"/>
                        <StackPanel>
                            <TextBlock Text="To" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="2,0,0,4"/>
                            <DatePicker x:Name="ToPicker" Width="180" SelectedDateChanged="Range_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Categories -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource PillButton}" Content="All" Padding="12,4" Click="SelectAll_Click"/>
                            <Button Style="{StaticResource PillButton}" Content="None" Padding="12,4" Margin="6,0,0,0" Click="SelectNone_Click"/>
                        </StackPanel>
                        <TextBlock Text="What to include" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel x:Name="CategoryChecks"/>
                </StackPanel>
            </Border>

            <!-- Details -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Name on report" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="Optional — printed at the top of the PDF so your doctor knows whose log it is."
                               FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBox x:Name="PatientBox" Width="320" HorizontalAlignment="Left" TextChanged="PatientBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- Summary + actions -->
            <Border Background="#F7F7F8" CornerRadius="12" Padding="20,16" Margin="0,4,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CsvBtn" Style="{StaticResource PillButton}" Content="Export CSV" Height="38" Click="ExportCsv_Click"/>
                        <Button x:Name="PdfBtn" Style="{StaticResource AccentButton}" Height="38" Margin="8,0,0,0" Padding="18,0"
                                Click="ExportPdf_Click" AutomationProperties.Name="Export PDF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Export PDF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BreakdownText" FontSize="12" Foreground="{StaticResource SubtleBrush}" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Result banner -->
            <Border x:Name="ResultBar" Visibility="Collapsed" Background="#E3F5EC" CornerRadius="10" Padding="16,10" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Content="Open" Padding="12,4" Click="OpenFile_Click"/>
                        <Button Style="{StaticResource PillButton}" Content="Show in folder" Padding="12,4" Margin="6,0,0,0" Click="ShowInFolder_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultText" VerticalAlignment="Center" FontSize="13" Foreground="#12704A"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
