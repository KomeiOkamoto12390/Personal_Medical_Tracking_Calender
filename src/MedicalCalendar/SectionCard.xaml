<UserControl x:Class="MedicalCalendar.SectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MedicalCalendar">
    <!-- DataContext: CategorySection -->
    <Border Style="{StaticResource Card}" x:Name="CardBorder">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse Width="10" Height="10" Fill="{Binding Def.Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Def.Title}" Style="{StaticResource CardTitle}" Margin="10,0,0,0"/>
                <Border Background="{Binding Def.Soft}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0"
                        VerticalAlignment="Center" MinWidth="18"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding Def.Ink}" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Logged entries -->
            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LogEntry}">
                        <Border x:Name="Row" CornerRadius="8" Padding="8,5" Margin="-8,0,-8,2" Background="Transparent"
                                ToolTip="Double-click to edit">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                              Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontSize="13" Foreground="{StaticResource SubtleBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="6" Padding="9,3" VerticalAlignment="Center"
                                        Background="{Binding DataContext.Def.Soft, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding DataContext.Def.Ink, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="13" Margin="12,0,4,0"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel x:Name="RowActions" Grid.Column="3" Orientation="Horizontal" Opacity="0">
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                            Content="&#xE70F;" ToolTip="Edit" AutomationProperties.Name="Edit"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10"
                                            Content="&#xE711;" ToolTip="Remove" AutomationProperties.Name="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F5F5F7"/>
                                <Setter TargetName="RowActions" Property="Opacity" Value="1"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Def.EmptyText}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,2" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>

            <!-- Add row. Wide: one line. Compact: name on top, the rest below (arranged in code). -->
            <Grid x:Name="AddRow" Margin="0,12,0,0">
                <Grid.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}"/>
                </Grid.InputBindings>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:SuggestBox x:Name="NameBox" Text="{Binding NewName}" ItemsSource="{Binding Items}"
                                  Placeholder="{Binding Def.NameHint}"
                                  RemoveItemCommand="{Binding RemoveCustomCommand}"/>

                <Grid x:Name="DetailHost">
                    <TextBox Text="{Binding NewDetail, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding Def.HasNoOptions, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Def.DetailHint}"
                               Visibility="{Binding ShowDetailHint, Converter={StaticResource BoolVis}}"/>
                    <ComboBox ItemsSource="{Binding Def.DetailOptions}" SelectedItem="{Binding NewDetail}"
                              Visibility="{Binding Def.HasOptions, Converter={StaticResource BoolVis}}"/>
                </Grid>

                <TextBox x:Name="TimeBox" Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="Time"/>

                <Button x:Name="CommitBtn" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}"
                        AutomationProperties.Name="{Binding CommitLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CommitGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CommitLabel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelBtn" Style="{StaticResource PillButton}" Content="Cancel" Margin="6,0,0,0"
                        Command="{Binding CancelEditCommand}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}"/>
            </Grid>
            <TextBlock Text="{Binding EditingText}" FontSize="12" Margin="2,8,0,0" Foreground="{Binding Def.Ink}"
                       TextWrapping="Wrap" Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </Border>
</UserControl>
